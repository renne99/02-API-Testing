  "item": [
    {
      "name": "Get All Products",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "  pm.response.to.have.status(200);\r",
              "});\r",
              "pm.test(\"Response contains a list of products\", function () {\r",
              "  const body = pm.response.json();\r",
              "  pm.expect(body.products).to.be.an(\"array\").that.is.not.empty;\r",
              "});\r",
              "pm.test(\"Response time is under 2000ms\", function () {\r",
              "  pm.expect(pm.response.responseTime).to.be.below(2000);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://dummyjson.com/products",
          "protocol": "https",
          "host": [
            "dummyjson",
            "com"
          ],
          "path": [
            "products"
          ]
        }
      },
      "response": []
    },
    {
